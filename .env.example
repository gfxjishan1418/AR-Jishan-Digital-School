# Digital AI School - Environment Configuration
# Copy this file to .env and configure your Supabase, Firebase, or AI keys

# ==========================================
# 1. Supabase Public Configuration (Optional)
# ==========================================
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# ==========================================
# 2. Firebase Configuration (Optional)
# ==========================================
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-app-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# ==========================================
# 3. AI Assistant Configuration (Optional)
# ==========================================
VITE_GEMINI_API_KEY=
VITE_AI_MODEL=gemini-1.5-flash

# ==========================================
# 4. School / System Context
# ==========================================
VITE_DEFAULT_SCHOOL_ID=school_dhaka_01
VITE_DEFAULT_LOCALE=en
VITE_APP_ENV=development
